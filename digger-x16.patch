+ #include <c64/types.h>
+ 
+ #include "kblib.h"
+ 
+ /* Global variables referenced by other modules */
+ volatile byte endgame;
+ volatile byte keychr, keydir, lkdir, pdir, ldir, fire, fires; 
+ 
+ __asm kb_isr
+ {
+   cmp #$3D  /* Translate SPACE for pause */
+   bne kb_stachr
+   lda #$39  
+ kb_stachr:
+   sta keychr
+ 
+ kb_f1_dn:
+   cmp #$70
+   bne kb_f1_up
+   lda #$ff
+   sta fire
+   sta fires
+   jmp kb_exit_h
+     
+ kb_f1_up:
+   cmp #$f0
+   bne kb_uparr_dn
+   lda #$0
+   sta fire
+   jmp kb_exit_h
+ 
+ kb_uparr_dn:
+   cmp #$53
+   bne kb_uparr_up
+   lda #DIR_UP
+   sta keydir
+   sta lkdir
+   jmp kb_exit_h
+ 
+ kb_uparr_up:
+   cmp #$d3
+   bne kb_dnarr_dn
+   lda keydir
+   cmp #DIR_UP
+   bne kb_exit_h
+   lda #DIR_ST
+   sta keydir
+   jmp kb_exit
+ 
+ kb_dnarr_dn:
+   cmp #$54
+   bne kb_dnarr_up
+   lda #DIR_DN
+   sta keydir
+   sta lkdir
+   jmp kb_exit    
+ 
+   /* Half-way jump point to avoid out-of range error */
+ kb_exit_h:     
+   jmp kb_exit
+     
+ kb_dnarr_up:
+   cmp #$d4
+   bne kb_ltarr_dn
+   lda keydir
+   cmp #DIR_DN
+   bne kb_exit
+   lda #DIR_ST
+   sta keydir
+   jmp kb_exit
+ 
+ kb_ltarr_dn:
+   cmp #$4f
+   bne kb_ltarr_up
+   lda #DIR_LT
+   sta keydir
+   sta lkdir
+   lda #PDIR_LEFT
+   sta pdir
+   sta ldir
+   jmp kb_exit
+ 
+ kb_ltarr_up:
+   cmp #$cf
+   bne kb_rtarr_dn
+   lda keydir
+   cmp #DIR_LT
+   bne kb_exit
+   lda #DIR_ST
+   sta keydir
+   lda #PDIR_STOP
+   sta pdir
+   jmp kb_exit
+ 
+ kb_rtarr_dn:
+   cmp #$59
+   bne kb_rtarr_up
+   lda #DIR_RT
+   sta keydir
+   sta lkdir
+   lda #PDIR_RIGHT
+   sta pdir
+   sta ldir
+   jmp kb_exit
+ 
+ kb_rtarr_up:
+   cmp #$d9
+   bne kb_exit
+   lda keydir
+   cmp #DIR_RT
+   bne kb_exit
+   lda #DIR_ST
+   sta keydir
+   lda #PDIR_STOP
+   sta pdir
+   jmp kb_exit    
+     
+ kb_exit:
+   lda #0 
+ }
+ 
+ void kb_init(void)
+ {
+   __asm {
+     php          /* Push processor flags */
+     sei          /* Disable interrupts, if enabled */
+     lda #<kb_isr /* Install our ISR */
+     sta $032e
+     lda #>kb_isr
+     sta $032f
+     plp          /* Pull processor flags, restoring interrupt enable state */
+   }
+ 
+   return;
+ }
+ 
+ int key_translate(int x)
+ {
+   return x;
+ }
