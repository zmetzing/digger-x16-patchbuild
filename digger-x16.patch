+ /* str must point to 3 storage bytes, will not be NULL terminated */
+ void minitoa(word j, byte *str)
+ {
+   word i;
+   
+   i = j / 100;
+   j = j - (100 * i);
+   str[0] = 0x30 + i;
+   i = j / 10;
+   j = j - (10 * i);
+   str[1] = 0x30 + i;
+   str[2] = 0x30 + j;
+   
+   return;
+ }
+ 
+ /* str must point to 2 storage bytes, will not be NULL terminated */
+ void minbtoh(byte b, byte *str)
+ {
+   str[0] = 0x30 + ((b & 0xf0) >> 4);
+   if (str[0] > 0x39) {
+     str[0] += 8;
+   }
+   str[1] = 0x30 + (b & 0x0f);
+   if (str[1] > 0x39) {
+     str[1] += 8;
+   }  
+ 
+   return;
+ }
+ 
+ /* Note: Does NOT offset the display. Used for debug info. */
+ void putdbg(byte row, byte col, byte *str, byte len)
+ {
+   dword vaddr = L1_BASE;
+   byte test = str[0];
+ 
+   /* Determine address */
+   vaddr += row << 7; /* 64 map width * 2 bytes per map entry */
+   vaddr += col << 1;
+ 
+   vram_put_at(vaddr, test); /* Strange that we need this */
+   while (len--) {
+     vram_put_at(vaddr++, *str++);
+     vram_put_at(vaddr++, 0x01);
+   }
+ }
+ 
+ void dbg_cache(void)
+ {
+   byte temp[40];
+   byte i, j;
+ 
+   j = 0;
+   for (i = 0; i < 8; i++) {
+     temp[j++] = 0x30 + i;
+     temp[j++] = ':';
+     minbtoh(collmap[i].vera_vram_idx, &temp[j++]);
+     j++;
+     temp[j++] = ' ';
+   }
+   putdbg(0, 0, temp, j);
+ 
+   j = 0;
+   for (i = 8; i < 16; i++) {
+     temp[j++] = 0x30 + i;
+     if (temp[j-1] > 0x39) temp[j-1] += 7;
+     temp[j++] = ':';
+     minbtoh(collmap[i].vera_vram_idx, &temp[j++]);
+     j++;
+     temp[j++] = ' ';
+   }
+ 
+   putdbg(1, 0, temp, j);
+   
+ }
+ 
+ void disp_collmap(byte n, byte row, char *temp)
+ {
+   temp[0] = 0x30 + n;
+   if (n > 9) {
+     temp[0] += 7;
+   }
+   temp[1] = ':';
+   temp[2] = 'x';
+   temp[3] = '=';
+   minitoa(collmap[n].x, &temp[4]);
+   temp[7] = ' ';
+   temp[8] = 'y';
+   temp[9] = '=';
+   minitoa(collmap[n].y, &temp[10]);
+   putdbg(row, 0, temp, 13);
+ 
+   temp[0] = 'w';
+   temp[1] = '=';
+   minitoa(collmap[n].x_width, &temp[2]);
+   temp[5] = ' ';
+   temp[6] = 'h';
+   temp[7] = '=';
+   minitoa(collmap[n].y_width, &temp[8]);
+   putdbg(row, 14, temp, 11);
+ 
+   return;
+ }
+ 
+ void disp_collmask(int collmask)
+ {
+   byte temp[16];
+ 
+   temp[15] = 0x30 + !(collmask & 0x0001);
+   temp[14] = 0x30 + !(collmask & 0x0002);
+   temp[13] = 0x30 + !(collmask & 0x0004);
+   temp[12] = 0x30 + !(collmask & 0x0008);
+   temp[11] = 0x30 + !(collmask & 0x0010);
+   temp[10] = 0x30 + !(collmask & 0x0020);
+   temp[9] = 0x30 + !(collmask & 0x0040);
+   temp[8] = 0x30 + !(collmask & 0x0080);
+   temp[7] = 0x30 + !(collmask & 0x0100);
+   temp[6] = 0x30 + !(collmask & 0x0200);
+   temp[5] = 0x30 + !(collmask & 0x0400);
+   temp[4] = 0x30 + !(collmask & 0x0800);
+   temp[3] = 0x30 + !(collmask & 0x1000);
+   temp[2] = 0x30 + !(collmask & 0x2000);
+   temp[1] = 0x30 + !(collmask & 0x4000);
+   temp[0] = 0x30 + !(collmask & 0x8000);
+   putdbg(0, 0, temp, 16);
+ 
+   disp_collmap(0, 1, temp);
+   disp_collmap(14, 29, temp);
+   
+   return;
+ }
