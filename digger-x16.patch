+ /* Collision array for active sprites */
+ typedef struct collmap_s {
+   /* Location index for sprite image data */
+   byte vera_vram_idx;
+   /* Upper-left coordinates */
+   word x;
+   byte y;
+   /* Size in pixels */
+   byte x_width;
