+  *  for screen initialization to place permanent objects on the screen.
+  */
+ void sp_put(int x, int y, const char *image, const char *outline, int x_width, int y_width)
+ {
+   byte ctr = 0;
+   dword vaddr = VERT_OFFS_MEM + (BYTES_PER_LINE_2BPP*y) + (x>>2);
+   byte linebuf[8], i;
+ 
+   if (x_width > sizeof(linebuf)) {
+     return;
+   }
+   
+   x16_rambank(2);
+   
+   for (; y_width > 0; y_width--) {
+     vram_getn(vaddr, linebuf, x_width);
+     for (i = 0; i < x_width; i++) {
+       linebuf[i] &= outline[ctr+i];
+       linebuf[i] |= image[ctr+i];
+     }
+     vram_putn(vaddr, (const char *)linebuf, x_width);
+     ctr += x_width;
+     vaddr = VERT_OFFS_MEM + (BYTES_PER_LINE_2BPP * ++y) + (x>>2);
+   }
+ 
+   x16_rambank(1);
+   
+   return;
+ }
