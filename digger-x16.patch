+ int sp_move(int n, int x, int y)
+ {
+   int collmask = 0;
+   byte i;
+   word x0, xi;
+   byte y0, yi;
+   byte w0, wi, h0, hi;
+   
+   collmap[n].x = x;
+   collmap[n].y = y;
+     
+   vera_spr_move(n, x, y + VERT_OFFS);
+ 
+   /* Collision box for this sprite */
+   x0 = x;
+   y0 = y;
+   w0 = collmap[n].x_width;
+   h0 = collmap[n].y_width;
+   
+   for (i = 0; i < GAMESPRITES; i++) {
+     if ((i != n) && (collmap[i].vis)) {
+       /* Collision box sprite i */
+       xi = collmap[i].x;
+       yi = collmap[i].y;
+       wi = collmap[i].x_width;
+       hi = collmap[i].y_width;
+       /* https://cs.pomona.edu/classes/cs181g/notes/collision.html */
+       /* Sprites must be overlapping by at least 1 pixel */
+       if ((x0 < (xi+wi)) &&
+ 	  (xi < (x0+w0)) &&
+ 	  (y0 < (yi+hi)) &&
+ 	  (yi < (y0+h0))) {
+ 	/* Rectangles are overlapping */
+ 	collmask |= 1 << i;
+       }
+     }
+   }
+ 
+ #ifdef DEBUG_SPR
+   if (n == 0) {
+     disp_collmask(collmask);
+     x16_vera_spr_ctl(n, VSPRPRI_FRONT);
+   }
+ #endif
+     
+   return collmask;
+ }
