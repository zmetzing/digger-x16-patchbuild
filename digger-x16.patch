+ /*
+  * This routine is used by the game to:
+  *  1) Determine the timer tick
+  *  2) Examine the CGA framebuffer background color
+  */
+ int peek(int cga_addr)
+ {
+   dword vaddr;
+   word x;
+   byte y;
+   byte field;
+   int retval;
+ 
+   if (defseg == 0x40) {
+     /* FIXME: Timer tick */
+     retval = 1;
+   } else {
+     /* We "undo" what the calling code has done: CGA framebuffer address --> x & y */
+     if (cga_addr > 0x2000) {
+       /* Odd lines */
+       field = 1;
+       cga_addr -= 0x2000;
+     } else {
+       /* Even lines */
+       field = 0;
+     }
+     /* This division truncates to give us lines, then 2x since VERA is linear */
+     y = (cga_addr / BYTES_PER_LINE_2BPP);
+     cga_addr -= (y * BYTES_PER_LINE_2BPP);
+     y = field + (y << 1);
+     /* Location of the 2bpp byte (not actually pixel location to avoid useless << then >>)*/
+     x = cga_addr;
+     
+     vaddr = VERT_OFFS_MEM + (y * BYTES_PER_LINE_2BPP) + x;
+     
+     retval = vram_get_at(vaddr);
+   }
+ 
+   return retval;
+ }
