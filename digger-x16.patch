+ void sp_place(int n, int x, int y)
+ {
+   collmap[n].x = x;
+   collmap[n].y = y;
+ 
+   vera_spr_move(n, x, y + VERT_OFFS);
+   x16_vera_spr_ctl(n, VSPRPRI_FRONT);
+   collmap[n].vis = 1;
+     
+   return;
+ }
