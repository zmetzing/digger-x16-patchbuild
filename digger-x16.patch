+ 		 ((image[ctr+i] & 0x03) ? color : 0));
+     }
+     vram_putn(vaddr, (const char *)line, x_wid);
+     ctr += x_wid;
+     vaddr = VERT_OFFS_MEM + (BYTES_PER_LINE_2BPP * ++y) + (x>>2);
