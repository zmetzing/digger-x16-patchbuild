+ void gentitle(void)
+ {
+   dword vaddr = L0_BASE + VERT_OFFS_MEM;
+   byte rlen, rdata;
+   word i;
+   word lbytes = 0;
+   byte row = 0;
+   byte skip = 0;
+ 
+   x16_rambank(3);
+ 
+   /* See https://www.seasip.info/VintagePC/cga.html for CGA details */
+   
+   for (i = 0; i < RLESIZE; i++) {
+     if (title_rle[i] != 0xfe) {
+       /* Seems a bit silly, but simplifies the logic to pretend it is RLL-encoded */
+       rlen = 1;
+       rdata = title_rle[i];
+     } else {
+       /* RLL coded */
+       rlen = title_rle[++i];
+       rdata = title_rle[++i];
+     }
+     /* There will always be room for 1 more byte;
+      *  otherwise, the row logic would have advanced vaddr
+      */
+     do {
+       if (skip == 0) {
+ 	vram_put_at(vaddr++, rdata);
+ 	lbytes++;
+       } else {
+ 	skip--;
+       }
+       /* May wrap to 255, means 256 bytes of run */
+       rlen--; 
+       
+       /* Check for room on this line */
+       if (lbytes == BYTES_PER_LINE_2BPP) {
+ 	/* vram now points at 1st byte of next line. Skip one extra line */
+ 	vaddr += BYTES_PER_LINE_2BPP;
+ 	row += 2;
+ 	lbytes = 0;
+ 	if (row > 199) {
+ 	  /* Do the odd lines next */
+ 	  row = 1;
+ 	  vaddr = L0_BASE + VERT_OFFS_MEM;
+ 	  vaddr += BYTES_PER_LINE_2BPP;
+ 	  /* There's a little gap in the CGA memory. Account for those 192 bytes. */
+ 	  skip = 192;
+ 	}
+       }
+     } while (rlen != 0);
+   }
+   
+   x16_rambank(1);
+ 
+   return;
+ }
