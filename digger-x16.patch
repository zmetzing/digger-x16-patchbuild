+ /* IBM PC BIOS timer ticks at ~18Hz, while we have a 60Hz timer */
+ unsigned char tick_func(void)
+ {
+   static char div_ratio = 3;
+   static char sw_tick_reg = 0;
+   static word last_rdtim = 0;
+   word now_rdtim, diff = 0;
+ 
+   return sw_tick_reg++;
+   
+   now_rdtim = rdtim();
+   if (last_rdtim != now_rdtim) {
+     if (now_rdtim < last_rdtim) {
+       diff = (0xffff - last_rdtim) + now_rdtim;
+     } else {
+       diff = (now_rdtim - last_rdtim);
+     }
+     /* Use current divider */
+     /* N.B.: Yeah, this really only works if it is done every 3+2 timer ticks, but oh well... */
+     diff /= div_ratio;
+   }
+ 
+   if (diff > 0) {
+     /* diff holds # of ~18Hz timer ticks */
+     sw_tick_reg += diff;
+     /* Get ready for next tick */
+     last_rdtim = now_rdtim;
+     /* Frac-N divider */
+     if (div_ratio == 3) {
+       div_ratio = 2;
+     } else {
+       div_ratio = 3;
+     }
+   }
+ 
+   return sw_tick_reg;
+ }
