+ /* Initialize (but don't show) sprite */
+ void sp_init(int n, const char *image, const char *outline, char *backgnd,
+ 	     int x_width, int y_width, int x_trim, int y_trim)
+ {
+   byte sprite[128] = { 0 };
+   dword sprite_ramloc = 0;
+   byte converted = 0;
+ 
+   converted = grlib_cache(image, &collmap[n].vera_vram_idx);
+   sprite_ramloc = GRLIB_VRAM(collmap[n].vera_vram_idx);
+   if (!converted) {
+     /* Needs conversion */
+     x16_rambank(2);
+     grlib_spr_conv(sprite, image, outline, x_width, y_width);
+     x16_rambank(1);
+     vram_putn(sprite_ramloc, sprite, 128);
+   } 
+   vera_spr_set(n, sprite_ramloc >> 5, VSPRMODE_4,
+ 	       VSPRSZIZE_16, VSPRSZIZE_16,
+ 	       VSPRPRI_OFF, 0);
+   
+   /* Save collision info on this sprite */
+   collmap[n].x = 0;
+   collmap[n].y = 0;
+   collmap[n].x_width = x_width << 2;
+   collmap[n].y_width = y_width;
+   collmap[n].vis = 0;
+   collmap[n].flag = 0;
+ 
+   return;
+ }
