+ #include <stddef.h>
+ #include <string.h>
+ 
+ #include "cx16/vera.h"
+ 
+ #include "graphlib.h"
+ 
+ /* Map of converted sprites within VERA's memory space */
+ veramap_t veramap[MAXVERASPR] = { 0 };
+ 
+ /* The map, explained:
+  *
+  *   DIGGER uses only 16x16 sprites, as that seems to work fine -- even
+  * though some sprites are actually wider than that. Those wider sprites
+  * don't seem to be reqired, however, so we've ignored this little discrepancy.
+  *
+  *   The original DOS-based game used 2 bit-per-pixel (bpp) sprites with a
+  * software library to manipulate them. VERA doesn't support 2 bpp, but we
+  * can take good advantage of its 4 bpp capability; Most sprites need a
+  * transparent color and a black color. We've set up the palette with two
+  * black values (offset 0 and 4).
+  *
+  *   At run-time, the 2 bpp sprite data is converted to 4 bpp once upon
+  * first use. This converted sprite data is stored in VERA's memory and
+  * used repeatedly any time the original 2 bpp sprite data pointer is
+  * referenced by the game code.
+  *
+  *   We could have converted these sprites en masse, but this method seems
+  * less encumbered by copyright issues (since we don't supply the original
+  * sprite data).
+  *
+  *   Each 16 x 16 4 bpp converted sprite image is stored in VERA RAM thusly:
+  *
+  *   image_data_start = SPRITE_BASE + idx * ((16 * 16) / 2)
+  *
+  */
+ 
+ void grlib_init(void)
+ {
+   byte i;
+ 
+   for (i = 0; i < MAXVERASPR; i++) {
+     veramap[i].image_ptr = NULL;
+   }
+ }
+ 
+ /*
+  * Returns:
+  *
+  *  0 - not found, vera_idx holds free sprite location
+  *  1 - found, vera_idx holds sprite location
+  *
+  */
+ byte grlib_cache(const byte *image, byte *vera_idx)
+ {
+   byte i;
+   byte first_free = MAXVERASPR + 1;
+   byte found = 0;
+ 
+   for (i = 0; i < MAXVERASPR; i++) {
+     if (veramap[i].image_ptr == NULL) {
+       /* Free, mark it if we haven't saved a spot already */
+       if (first_free > MAXVERASPR) {
+ 	first_free = i;
+       }
+     } else {
+       if (veramap[i].image_ptr == image) {
+ 	/* Already converted */
+ 	*vera_idx = i;
+ 	found = 1;
+ 	break;
+       }
+     }
+   }
+   if (i >= MAXVERASPR) {
+     /* Not found. Provide first free slot. */
+     *vera_idx = first_free;
+     veramap[first_free].image_ptr = (byte *)image;
+   }
+ 
+   return found;
+ }
+ 
+ /* Convert variable 2-bit sprite to 16x16 4-bit mode */
+ /*  e.g. ddcc bbaa -> 00dd 00cc 00bb 00aa            */
+ /* FIXME: Some sprites are 20 or 24 pixels wide -- this code needs to handle that */
+ void grlib_spr_conv(byte *out, const byte *in, const byte *oline, byte x, byte y)
+ {
+   byte row, i, k, j;
+ 
+   /* Clear out 16x16 4-bpp sprite (128 bytes) */
+   memset(out, 0, 128);
+ 
+   if (!x || !y || (x > 4) || (y > 16)) {
+     /* Over-sized sprites are not supported */
+     return;
+   }
+ 
+   j = 0;
+   for (row = 0; row < 16; row++) {
+     if (row < y) {
+       for (i = 0; i < 4; i++) {
+ 	if (i >= x) {
+ 	  /* Sprite data is narrower than 16 px */
+ 	  continue;
+ 	}
+ 	/* 2-bpp (1 byte) -> 4-bpp (2 bytes) */
+ 	/* High byte */
+ 	k=(i<<1)+(row<<3);
+ 	out[k+1] =
+ 	  (in[j] & 0x3) |
+ 	  ((in[j] & 0xc) << 2);
+ 	/* Handle transparency */
+ 	if (!(oline[j] & 0x1) && !(out[k+1] & 0x0f)) {
+ 	  out[k+1] |= 0x04;
+ 	}
+ 	if (!(oline[j] & 0x4) && !(out[k+1] & 0xf0)) {
+ 	  out[k+1] |= 0x40;
+ 	}
+ 	/* Low byte */
+ 	out[k] =
+ 	  ((in[j] & 0x30) >> 4) |
+ 	  ((in[j] & 0xc0) >> 2);
+ 	/* Handle transparency */
+ 	if (!(oline[j] & 0x10) && !(out[k] & 0x0f)) {
+ 	  out[k] |= 0x04;
+ 	}
+ 	if (!(oline[j] & 0x40) && !(out[k] & 0xf0)) {
+ 	  out[k] |= 0x40;
+ 	}
+ 	j++;
+       }
+     }
+   }
+ }
+ 
+ /* Used to turn on/off sprites quickly */
+ void x16_vera_spr_ctl(byte spr, VERASpritePriority prio)
+ {
+   __assume(spr < 128);
+ 
+   vram_addr(0x1fc00UL + (spr * 8) + 6);
+   vram_put(prio << 2);
+ 
+   return;
+ }
+ 
+ /* Used to change the image address of a sprite quickly */
+ void x16_vera_spr_addr(byte spr, word image_addr)
+ {
+   __assume(spr < 128);
+   
+   vram_addr(0x1fc00UL + spr * 8);
+   vram_putw(image_addr);
+ }
+ 
