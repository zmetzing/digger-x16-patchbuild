+ static word cal_loop_1ms = 0;
+ 
+ /* RAM bank functions */
+ void x16_rambank(byte bank)
+ {
+   *(volatile __memmap char *)0x00 = bank;
+ }
+ 
+ void x16_rombank(byte bank)
+ {
+   *(volatile __memmap char *)0x01 = bank;
+ }
+ 
+ /* This is the Lattice C version of snprintf, sorta. */
+ int stcu_d(char *out, unsigned char in, int outlen)
+ {
+   /* We do not support the full range of input. */
+   __assume(in < 10);
+ 
+   /* If you try, we'll chop you off at the knees. */
+   out[0] = 0x30 + in;
+ 
+   /* You only get one character out of us. */
+   return 1;
+ }
+ 
+ /* Return RDTIM (24-bit) time */
+ dword rdtim(void)
+ {
+   return __asm
+     {
+       jsr $FFDE   /* RDTIM */
+       sta accu
+       stx accu + 1
+       sty accu + 2
+     };
+ }
+ 
+ /* Calibrate sleep duration */
+ void cal_sleep(void)
+ {
+   char now, last;
+   
+   /* Synchronize */
+   now = last = rdtim() & 0xff;
+   while (now == last) {
+     now = rdtim() & 0xff;
+   }
+   /* Timing loop: Time 18Hz tick */
+   last = now;
+   while (now == last) {
+     cal_loop_1ms++;
+     now = rdtim() & 0xff;
+   }
+   /* Divide out the 1ms tick, roughly. */
+   //cal_loop_1ms >>= 1;
+ }
+ 
+ /* sleep() is never used for > 200 msec in Digger */
+ void sleep(byte msec)
+ {
+   volatile byte *scanline_l = (void *)0x9f28;
+   volatile byte *ien = (void *)0x9f26;
+   word target, now;
+   byte excess;
+ 
+   /* Roughly 32usec per VERA line (25MHz clock) */
+   while (msec--) {
+     now = ((*ien & 0x40) << 2 ) + *scanline_l;
+     while (now > 510) {
+       /* No-man's land on the scanline, wait for zero */
+       now = ((*ien & 0x40) << 2 ) + *scanline_l;
+     }
+     target = now + 31;
+     if (target > 510) {
+       /* Would push us over into no-man's land */
+       excess = (target - 510);
+       target = 510;
+     } else {
+       excess = 0;
+     }
+     do {
+       now = ((*ien & 0x40) << 2 ) + *scanline_l;
+     } while (now < target);
+     /* TODO: Handle excess */
+   }
+ }
+ 
